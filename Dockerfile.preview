# Production integration preview. The existing Dockerfile/Compose remain for development.
FROM node:22.20.0-bookworm-slim
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Store the verified production build in the image, not in a disposable check container.
RUN npm run check
ENV NODE_ENV=production
EXPOSE 3000
CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0"]
